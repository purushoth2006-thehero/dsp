# Copy these into Vercel: Project > Settings > Environment Variables.
# Not needed for `npm run dev`: locally the app uses safe defaults (admin / admin123, data in .data/db.json).

# Required in production. At least 8 characters.
ADMIN_PASSWORD=

# Required in production. At least 24 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Defaults to "admin".
ADMIN_USERNAME=admin

# Added automatically when you connect an Upstash Redis database to the Vercel project
# (Storage tab). Either pair of names works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ----- Lesson reminders (optional) -----
# Without these, nothing is sent. Reminders go out by WhatsApp and/or SMS through Twilio.
# A random secret (16+ characters) that protects the reminder URLs. Vercel Cron uses it automatically.
CRON_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender, e.g. whatsapp:+14155238886 (Twilio sandbox) or your approved WhatsApp number
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp message template (needed to message customers first). Variables: 1 name, 2 today/tomorrow, 3 date, 4 time, 5 place, 6 trainer
TWILIO_WHATSAPP_CONTENT_SID=
# SMS sender (a Twilio number or an Indian DLT-registered sender ID)
TWILIO_SMS_FROM=
