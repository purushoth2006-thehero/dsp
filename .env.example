# Copy these into Vercel: Project > Settings > Environment Variables.
# Not needed for `npm run dev`: locally the app uses safe defaults (admin / admin123, data in .data/db.json).

# Required in production. At least 8 characters.
ADMIN_PASSWORD=

# Required in production. At least 24 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Defaults to "admin".
ADMIN_USERNAME=admin

# Added automatically when you connect an Upstash Redis database to the Vercel project
# (Storage tab). Either pair of names works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
